{
  "name": "token-arcade-metropolis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --experimental-sqlite --experimental-strip-types apps/api/src/server.ts",
    "build": "npm run build:cartridges && tsc --noEmit && vite build",
    "setup:cartridges": "npm ci --prefix cartridges/coindle",
    "build:cartridges": "vite build --config cartridges/coindle/arcade.vite.config.ts",
    "dev:cartridges": "node --env-file-if-exists=.env scripts/cartridges.mjs",
    "test": "node --experimental-sqlite --experimental-strip-types scripts/run-tests.mjs",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "@privy-io/node": "^0.35.0",
    "@privy-io/react-auth": "^3.48.0",
    "lucide-react": "^1.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.56.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  },
  "overrides": {
    "viem": { "ws": "^8.21.0" },
    "isows": { "ws": "^8.21.0" }
  }
}
