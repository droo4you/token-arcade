{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-arcade/cartridge.schema.json",
  "title": "Token Arcade cartridge.json (v0.1 draft)",
  "description": "Handoff \u00a79 Step 2 fields are required. All other fields are PROPOSED extensions (CARTRIDGE_SPEC.md \u00a78).",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "version",
    "artwork",
    "developer",
    "supportedModes",
    "supportedObjectives",
    "communityOptional",
    "minicoinOptional"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,48}$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "artwork": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "developer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "supportedModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "free_play",
          "ranked_run",
          "community_raid"
        ]
      }
    },
    "supportedObjectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "communityOptional": {
      "type": "boolean"
    },
    "minicoinOptional": {
      "type": "boolean"
    },
    "integrationLevel": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "skeleton": {
      "enum": [
        "forced_forward_dodger",
        "ratchet_climber",
        "momentum_pump",
        "commit_and_simulate",
        "timing_intercept",
        "arena_survival",
        "course_navigator",
        "grid_logic",
        "build_and_resolve",
        "daily_deduction"
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "url",
        "origin",
        "kind"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "iframe",
            "module"
          ]
        }
      }
    },
    "hostOrigins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "enum": [
          "pointer_tap",
          "pointer_drag",
          "touch_tap",
          "touch_drag",
          "keyboard",
          "gamepad",
          "tilt",
          "text"
        ]
      }
    },
    "orientation": {
      "enum": [
        "any",
        "landscape",
        "portrait"
      ]
    },
    "mobile": {
      "enum": [
        "full",
        "landscape_only",
        "keyboard_required",
        "unsupported"
      ]
    },
    "runLength": {
      "type": "object",
      "properties": {
        "typicalSec": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "maxSec": {
          "type": "number"
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "primary",
          "order",
          "tieBreak"
        ],
        "properties": {
          "primary": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "order": {
            "enum": [
              "asc",
              "desc"
            ]
          },
          "secondary": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tieBreak": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "raidAggregation": {
            "type": "array",
            "items": {
              "enum": [
                "best_n_sum",
                "sum",
                "best",
                "mean_best_n"
              ]
            },
            "description": "PROPOSED hint (CARTRIDGE_SPEC \u00a710.8); raid config is authoritative."
          }
        }
      }
    },
    "determinism": {
      "enum": [
        "none",
        "seeded",
        "replayable-v8",
        "replayable-portable",
        "server_authoritative"
      ]
    },
    "simVersion": {
      "type": "string"
    },
    "tickHz": {
      "type": "number"
    },
    "seedPolicy": {
      "enum": [
        "none",
        "per_run",
        "per_attempt",
        "fixed_level_set",
        "server_secret_answer"
      ]
    },
    "rulesSchema": {
      "type": "object"
    },
    "plausibility": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "attemptsDefault": {
      "type": "integer",
      "minimum": 1
    },
    "cosmeticSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "sprite",
              "palette",
              "image",
              "audio"
            ]
          }
        }
      }
    },
    "minicoin": {
      "type": "object",
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "verifier": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "replay",
            "server_authoritative",
            "session_checks"
          ]
        },
        "entry": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        }
      }
    },
    "removedInArcade": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "simHash": {
      "type": "string",
      "pattern": "^sha256:",
      "description": "PROPOSED. Hash of the scored-path sources (sim + RNG + scoring). Pinned in rulesHash. Skins and cosmetics never change it (RESKIN_SPEC \u00a72)."
    },
    "skinSlotsVersion": {
      "type": "string",
      "description": "PROPOSED. Version of the skinSlots contract; skin packs target it."
    },
    "skinAssetOrigins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://[^/]+$"
      },
      "description": "PROPOSED. Allowlisted CDN origins for skin.json and skin assets (CSP img/media/font-src)."
    },
    "skinSlots": {
      "type": "array",
      "description": "PROPOSED (RESKIN_SPEC \u00a74). Per-listing skin-pack slots. Only SKINNABLE surfaces may be declared.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          },
          "kind": {
            "enum": [
              "roster",
              "sprite",
              "spriteSet",
              "image",
              "palette",
              "font",
              "musicPack",
              "sfxPack",
              "strings",
              "communityDisplay"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "constraints": {
            "type": "object",
            "properties": {
              "rosterAffectsSim": {
                "const": "never"
              }
            }
          }
        }
      }
    },
    "defaultSkin": {
      "$ref": "#/$defs/skinRef",
      "description": "PROPOSED. Skin pack reproducing the game's stock look (RESKIN_SPEC \u00a71)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "integrationLevel": {
            "const": "L0"
          }
        }
      },
      "then": {
        "properties": {
          "supportedModes": {
            "items": {
              "const": "free_play"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "integrationLevel": {
            "const": "L1"
          }
        }
      },
      "then": {
        "properties": {
          "supportedModes": {
            "items": {
              "enum": [
                "free_play",
                "ranked_run"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "skinSlots"
        ]
      },
      "then": {
        "required": [
          "skinSlotsVersion",
          "skinAssetOrigins"
        ]
      }
    }
  ],
  "$defs": {
    "skinRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skinId",
        "version",
        "manifestUrl",
        "sha256"
      ],
      "properties": {
        "skinId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
        },
        "version": {
          "type": "string"
        },
        "manifestUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string"
        }
      }
    }
  }
}