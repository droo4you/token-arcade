{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-arcade/reskin.schema.json",
  "title": "Token Arcade skin pack skin.json (ta-skin/1, draft)",
  "description": "Structural schema for a skin pack (RESKIN_SPEC.md §6). Slot-specific limits (sizes, keys, maxLen, charset) come from the target cartridge's cartridge.json skinSlots and are validated in a second pass. Skins are data only: no field may contain code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "skinId", "version", "name", "cartridge", "assetBase", "slots", "assets", "rights"],
  "$defs": {
    "relPath": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.(png|webp|m4a|mp3|ogg|woff2)$" },
    "srcList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relPath" } },
    "spriteSheet": {
      "type": "object", "additionalProperties": false,
      "required": ["src", "w", "h", "frames", "fps"],
      "properties": {
        "src": { "$ref": "#/$defs/relPath" },
        "w": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "h": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "frames": { "type": "integer", "minimum": 1, "maximum": 64 },
        "fps": { "type": "number", "minimum": 1, "maximum": 60 },
        "anchor": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 2, "maxItems": 2 },
        "layers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/relPath" } },
        "stretch": { "enum": ["none", "nine_slice", "fit_hitbox"] }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "rosterValue": {
      "type": "object", "additionalProperties": false, "required": ["characters"],
      "properties": {
        "characters": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "name", "animations"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
              "name": { "type": "string", "maxLength": 24 },
              "blurb": { "type": "string", "maxLength": 80 },
              "animations": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/spriteSheet" } }
            }
          }
        }
      }
    },
    "musicPackValue": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "tracks": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "name", "src"],
            "properties": {
              "id": { "type": "string" }, "name": { "type": "string", "maxLength": 32 },
              "src": { "$ref": "#/$defs/srcList" },
              "loopStartMs": { "type": "integer", "minimum": 0 }, "loopEndMs": { "type": "integer", "minimum": 0 },
              "bpm": { "type": "number" }
            }
          }
        },
        "synthPreset": { "type": "object", "description": "Validated against the cartridge's declared preset schema; numbers/strings only." }
      },
      "anyOf": [ { "required": ["tracks"] }, { "required": ["synthPreset"] } ]
    },
    "sfxPackValue": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["src"],
        "properties": { "src": { "$ref": "#/$defs/srcList" }, "gain": { "type": "number", "minimum": 0, "maximum": 2 } }
      }
    },
    "stringsValue": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 140 } },
    "paletteValue": { "type": "object", "minProperties": 1, "maxProperties": 32, "additionalProperties": { "$ref": "#/$defs/color" } },
    "communityDisplayValue": {
      "type": "object", "additionalProperties": false, "required": ["name", "disclaimer"],
      "properties": {
        "name": { "type": "string", "maxLength": 40 },
        "ticker": { "type": "string", "maxLength": 12 },
        "logo": { "$ref": "#/$defs/relPath" },
        "url": { "type": "string", "pattern": "^https://" },
        "colors": { "type": "object", "additionalProperties": { "$ref": "#/$defs/color" } },
        "contract": {
          "type": "object", "additionalProperties": false,
          "description": "Display only. Never used for eligibility or transactions.",
          "properties": { "chainId": { "type": "integer" }, "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" } }
        },
        "disclaimer": { "type": "string", "minLength": 10, "maxLength": 160 },
        "official": { "type": "boolean", "description": "Admin-only. Requires permission evidence in rights.permissions." }
      }
    }
  },
  "properties": {
    "format": { "const": "ta-skin/1" },
    "skinId": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "name": { "type": "string", "maxLength": 80 },
    "description": { "type": "string", "maxLength": 280 },
    "cartridge": {
      "type": "object", "additionalProperties": false, "required": ["id", "versions", "skinSlotsVersion"],
      "properties": { "id": { "type": "string" }, "versions": { "type": "string" }, "skinSlotsVersion": { "type": "string" } }
    },
    "assetBase": { "type": "string", "pattern": "^https://[^/]+/.*/$" },
    "slots": {
      "type": "object", "minProperties": 1,
      "description": "Keys must be slot ids declared by the cartridge. Values are checked per declared kind in pass two.",
      "properties": { "communityDisplay": { "$ref": "#/$defs/communityDisplayValue" } },
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/rosterValue" }, { "$ref": "#/$defs/spriteSheet" }, { "$ref": "#/$defs/musicPackValue" },
          { "$ref": "#/$defs/sfxPackValue" }, { "$ref": "#/$defs/stringsValue" }, { "$ref": "#/$defs/paletteValue" },
          { "type": "object", "additionalProperties": { "$ref": "#/$defs/spriteSheet" } },
          { "type": "object", "required": ["src", "w", "h"], "properties": { "src": { "$ref": "#/$defs/relPath" }, "w": { "type": "integer" }, "h": { "type": "integer" } } },
          { "type": "object", "required": ["family", "src"], "properties": { "family": { "type": "string" }, "src": { "$ref": "#/$defs/relPath" }, "license": { "type": "string" } } }
        ]
      }
    },
    "assets": {
      "type": "array", "minItems": 1, "maxItems": 400,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes", "mime"],
        "properties": {
          "path": { "$ref": "#/$defs/relPath" },
          "sha256": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 2097152 },
          "mime": { "enum": ["image/png", "image/webp", "audio/mp4", "audio/mpeg", "audio/ogg", "font/woff2"] },
          "critical": { "type": "boolean" }
        }
      }
    },
    "rights": {
      "type": "object", "additionalProperties": false, "required": ["attestedBy", "attestedAt", "statement", "assets"],
      "properties": {
        "attestedBy": { "type": "string" },
        "attestedAt": { "type": "string" },
        "statement": { "type": "string" },
        "assets": {
          "type": "array",
          "items": {
            "type": "object", "required": ["path", "license"],
            "properties": {
              "path": { "type": "string" },
              "license": { "enum": ["owned", "CC0", "CC-BY-4.0", "community-license", "licensed"] },
              "source": { "type": "string" }, "attribution": { "type": "string" }, "grantRef": { "type": "string" }
            }
          }
        },
        "permissions": {
          "type": "array",
          "items": { "type": "object", "required": ["holder", "scope", "evidence"],
                     "properties": { "holder": { "type": "string" }, "scope": { "type": "string" }, "evidence": { "type": "string" } } }
        }
      }
    },
    "generatedBy": {
      "type": "object", "required": ["kind"],
      "properties": { "kind": { "enum": ["human", "ai_assisted"] }, "madlib": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 200 } } }
    },
    "review": {
      "type": "object",
      "properties": { "status": { "enum": ["pending", "approved", "rejected", "unpublished", "example"] }, "reviewedBy": { "type": "string" }, "reviewedAt": { "type": "string" }, "notes": { "type": "string" } }
    }
  }
}
