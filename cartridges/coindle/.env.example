# Required: Pyth Hermes API key.
# Hermes rejects unauthenticated requests with 401, so this is no longer
# optional. Sent as `Authorization: Bearer <key>` (`X-Api-Key` is rejected).
PYTH_API_KEY=

# Optional: Secret to protect the daily cron endpoint on Vercel
CRON_SECRET=

# Required for leaderboard, analytics and reports
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
