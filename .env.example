# Browser-side Privy app ID. Leave blank for Guest-only UI.
VITE_PRIVY_APP_ID=
# Server uses the same app ID and optional verification key/secret per Privy setup.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Comma-separated Privy user IDs allowed to use Launch Console.
ADMIN_PRIVY_IDS=
# Local developer test identity is disabled unless explicitly set to true.
LOCAL_DEMO_MODE=false
PORT=8787
# Reviewed cartridge builds must use a different origin from the arcade.
CARTRIDGE_ORIGIN=http://127.0.0.1:8788
CARTRIDGE_PORT=8788
ARCADE_API_ORIGIN=http://127.0.0.1:8787
ARCADE_HOST_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8787,http://localhost:8787
# Additional curator-approved build origins, comma-separated.
ALLOWED_CARTRIDGE_ORIGINS=
# Optional Coindle live data. Missing data is labeled unavailable; gameplay stays open.
PYTH_API_KEY=
# Monad chain and verified contract addresses. Leave blank for local demo.
MONAD_RPC_URL=
MONAD_CHAIN_ID=
TREASURY_ADDRESS=
MINICOIN_FACTORY_ADDRESS=
REWARD_VAULT_ADDRESS=
# Deliberate opt-in for the owner-only Minicoin factory write endpoint.
ENABLE_ONCHAIN_WRITES=false
DEPLOYER_PRIVATE_KEY=
# Address that receives the Minicoin's one-time initial supply.
MINICOIN_SUPPLY_RECIPIENT=
